{
  "ConnectionStrings": {
    "ChatDatabase": "Server=(localdb)\\mssqllocaldb;Database=ChatApp;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "UploadStorage": {
    "Provider": "AzureBlob",
    "Path": "uploads",
    "AzureBlob": {
      "UseManagedIdentity": true,
      "ConnectionString": "",
      "StorageAccountName": "",
      "Container": "chatapp-uploads",
      "Path": "uploads",
      "LocalCacheFolder": "upload-cache"
    }
  },
  "Notification": {
    "Provider": "AzureNotificationHub",
    "AzureNotificationHub": {
      "ConnectionString": "",
      "HubName": "",
      "VapidPublicKey": "",
      "FrontendBaseUrl": "http://localhost:5173"
    }
  },
  "Calling": {
    "Provider": "AzureCommunicationServices",
    "AzureCommunicationServices": {
      "ConnectionString": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "OpenTelemetry": {
      "IsEnabled": false,
      "ServiceName": "ChatApp.Api",
      "TraceEnabled": true,
      "MetricEnabled": true,
      "Otlp": {
        "IsEnabled": false,
        "Endpoint": "http://localhost:4317"
      },
      "AzureMonitor": {
        "IsEnabled": false,
        "ConnectionString": "xxx"
      }
    }
  },
  "AllowedHosts": "*"
}
