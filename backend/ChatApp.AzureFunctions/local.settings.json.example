    "ServiceBusSubscriptionName": "recording-file-status-updated-debug",
    "ConnectionStrings__ChatDatabase": "Server=(localdb)\\mssqllocaldb;Database=ChatApp;Trusted_Connection=True;TrustServerCertificate=True",
    "Api__BaseUrl": "http://localhost:5045"
  }
}
